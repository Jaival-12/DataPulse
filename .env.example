# Copy to .env (ignored by Git) and replace every placeholder before starting Airflow.
# Generate secrets locally; never reuse the examples or commit the resulting .env.
DATAPULSE_INTERNAL_TOKEN=replace-with-a-random-64-character-hex-token
AIRFLOW_DB_PASSWORD=replace-with-a-random-alphanumeric-password
AIRFLOW_FERNET_KEY=replace-with-a-generated-fernet-key
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-a-long-random-secret
AIRFLOW_ADMIN_USERNAME=datapulse-admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-unique-admin-password
AIRFLOW_ADMIN_EMAIL=admin@localhost
AIRFLOW_UID=50000
DATAPULSE_HTTP_TIMEOUT_SECONDS=15
